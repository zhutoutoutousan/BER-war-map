{
  "name": "ber-war-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "clean": "node --input-type=module -e \"import fs from 'fs'; fs.rmSync('.next',{recursive:true,force:true}); console.log('Removed .next');\"",
    "dev": "node --max-old-space-size=4096 node_modules/next/dist/bin/next dev -p 3001",
    "dev:fresh": "npm run clean && npm run dev",
    "build": "node --max-old-space-size=4096 node_modules/next/dist/bin/next build",
    "start": "node --max-old-space-size=4096 node_modules/next/dist/bin/next start -p 3001",
    "lint": "next lint",
    "presentation:screenshots": "node scripts/capture-presentation-screenshots.mjs",
    "video:demos": "node scripts/presentation-video/record-demos.mjs",
    "video:slides": "python scripts/presentation-video/render-slides.py",
    "video:slides:latex": "node scripts/presentation-video/render-slides-from-latex.mjs",
    "video:slides:html": "node scripts/presentation-video/render-slides.mjs",
    "video:tts": "python scripts/presentation-video/synthesize-tts.py",
    "video:rehearsal": "node scripts/presentation-video/assemble-rehearsal.mjs",
    "video:rehearsal:mobile": "node scripts/presentation-video/assemble-rehearsal-mobile.mjs",
    "video:script:export": "node scripts/presentation-video/export-stage-script.mjs",
    "video:script:pdf": "node scripts/presentation-video/export-stage-script.mjs --pdf",
    "video:promo": "node scripts/presentation-video/assemble-promo.mjs",
    "test:e2e": "playwright test",
    "test:ux": "playwright test e2e/stakeholder-ux.spec.ts",
    "test:ux:fresh": "npm run clean && playwright test e2e/stakeholder-ux.spec.ts",
    "submission:figures": "node docs/presentation/final-submission/copy-figures.mjs",
    "submission:pdf": "npm run submission:figures && cd docs/presentation/final-submission && pdflatex -interaction=nonstopmode idi-s26-final-submission.tex && pdflatex -interaction=nonstopmode idi-s26-final-submission.tex",
    "graf:briefing:data": "node scripts/sync-graf-briefing-data.mjs && node demos/graf-beschaeftigung-briefing/enrich-employees.mjs && node demos/graf-beschaeftigung-briefing/predict-employees.mjs && node scripts/sync-graf-briefing-data.mjs",
    "graf:report": "node demos/graf-beschaeftigung-briefing/build-report.mjs",
    "video:all": "node scripts/presentation-video/generate-all.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^5.8.0",
    "next": "^15.5.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.29.0",
    "eslint-config-next": "^15.5.0",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.8.3"
  }
}
