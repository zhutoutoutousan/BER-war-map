{
  "name": "ber-war-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "clean": "node --input-type=module -e \"import fs from 'fs'; fs.rmSync('.next',{recursive:true,force:true}); console.log('Removed .next');\"",
    "dev": "node --max-old-space-size=4096 node_modules/next/dist/bin/next dev -p 3001",
    "dev:fresh": "npm run clean && npm run dev",
    "build": "node --max-old-space-size=4096 node_modules/next/dist/bin/next build",
    "start": "node --max-old-space-size=4096 node_modules/next/dist/bin/next start -p 3001",
    "lint": "next lint",
    "presentation:screenshots": "node scripts/capture-presentation-screenshots.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^5.8.0",
    "next": "^15.5.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.29.0",
    "eslint-config-next": "^15.5.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.8.3"
  }
}
